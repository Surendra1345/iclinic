# Template for the server's ~/iclinic/.env (never commit the real file).
# Copy it to the server, fill in the values, then `chmod 600 .env`.

# --- Needed by docker-compose.prod.yml ---
# Public hostname of the server (HTTPS certificate is issued for it).
DOMAIN=iclinic-surendra.indiasouthcentral.cloudapp.azure.com
# Letters and digits only (it is placed inside a URL). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Used by the backend (same names as the development .env) ---
# The app builds the Twilio webhook URLs and checks Twilio's signature against this address.
NGROK_URL=https://iclinic-surendra.indiasouthcentral.cloudapp.azure.com
PUBLIC_DOMAIN=https://iclinic-surendra.indiasouthcentral.cloudapp.azure.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_PROVIDERS_CHAT=groq,gemini
LLM_PROVIDERS_CALL=groq,gemini
LLM_PROVIDERS_VOICE=gemini,groq

SARVAM_API_KEY=
SARVAM_TTS_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The server is on the public internet: list the numbers the clinic may call, comma separated.
OUTBOUND_CALL_ALLOWED_NUMBERS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

FRONT_DESK_EMAIL=
FRONT_DESK_PHONE=
# Choose a strong password: the front-desk dashboard is reachable from the internet.
FRONTDESK_EMAIL=
FRONTDESK_PASSWORD=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

CLINIC_NAME=City Care Clinic
AGENT_NAME=Happy
CLINIC_HOURS_START=9
CLINIC_HOURS_END=18
LOG_LEVEL=INFO
DIAGNOSTICS_API_KEY=
